# 忽略 Git 历史
.git
.gitignore

# ⚠️ CRITICAL: 防止敏感信息泄露到 Docker 镜像
.env
.env.*
!.env.example

# 忽略本地虚拟环境
venv/
__pycache__/
*.pyc

# 忽略临时文件
*.log
.DS_Store

# 忽略 Docker 配置自身
Dockerfile
docker-compose.yml

# 忽略 Node.js 前端构建产物和依赖
web/node_modules/
web/.next/
web/out/
web/.env.local

# 忽略数据库和缓存文件
chroma_db/
*.db
*.sqlite
generated_audio/

# 忽略开发工具配置
.vscode/
.idea/
*.swp
*.swo